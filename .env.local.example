# ── Supabase ─────────────────────────────────────────────────────
# Obtenlos en: Supabase Dashboard → Settings → API

# URL del proyecto (empieza con https://)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anon pública (safe para el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Para n8n ─────────────────────────────────────────────────────
# Nodo Supabase: usa URL + Service Role Key
# Nodo Postgres: en Supabase → Settings → Database → Connection string
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
