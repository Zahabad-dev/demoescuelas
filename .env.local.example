# ── Base de datos Railway PostgreSQL ────────────────────────────
# Obtén esta URL en: Railway > Tu proyecto > PostgreSQL > Connect
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.app:PORT/railway

# ── JWT Secret ───────────────────────────────────────────────────
# Genera una clave segura con: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-una-clave-secreta-muy-larga-minimo-32-caracteres

# ── App URL (para Vercel, usa la URL de tu deployment) ──────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
